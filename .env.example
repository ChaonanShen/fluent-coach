# Copy this file to .env for local development.
# Do not put real secrets in .env.example.

# Pronunciation assessment provider.
# Supported planned values: mock, tencent_soe, xfyun_ise
PRON_PROVIDER=mock

# Tencent Cloud SOE pronunciation assessment.
# TENCENT_APP_ID is the Tencent Cloud APPID, not the UIN / main account ID.
TENCENT_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SOE_WS_URL=wss://soe.cloud.tencent.com/soe/api
TENCENT_SOE_SERVER_ENGINE_TYPE=16k_en
TENCENT_SOE_EVAL_MODE=1
TENCENT_SOE_SCORE_COEFF=3.0

# Optional pronunciation assessment for normal voice conversation turns.
# Empty keeps the code default: enabled for real providers, disabled for mock.
PRON_ASSESS_AUDIO_TURNS=

# Xfyun ISE pronunciation assessment.
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_ISE_ENDPOINT=wss://ise-api.xfyun.cn/v2/open-ise
XFYUN_ISE_ENT=en_vip
XFYUN_ISE_CATEGORY=read_sentence

# Local ASR and LLM defaults.
ASR_PROVIDER=fake
ASR_MODEL_SIZE=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# TTS defaults to browser speechSynthesis. Set openai_compatible to call
# <TTS_BASE_URL>/audio/speech and return audio to the frontend.
TTS_PROVIDER=browser
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_RESPONSE_FORMAT=mp3
TTS_TIMEOUT_SECONDS=30
